#!/usr/bin/python3
# omarchy:summary=Print the Pi usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Pi agent usage into one display-ready JSON record.

Reads Pi JSONL session files from ~/.pi/agent/sessions/ and produces the
record contract the Omarchy agents panel expects. Token counts come from
the usage object on assistant messages and nested usage on toolResult
messages.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
from pathlib import Path
from typing import Any

AGENT_ID = "pi"
AGENT_NAME = "Pi"
AUTH_HELP = ""


def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def sessions_root() -> Path:
    return expand_path(os.environ.get("PI_SESSIONS_DIR") or "~/.pi/agent/sessions")


def number(value: Any) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_day(value: Any) -> str:
    if value is None:
        return dt.datetime.now().strftime("%Y-%m-%d")
    if isinstance(value, (int, float)):
        # Pi message timestamps are milliseconds.
        if value > 10_000_000_000:
            value = value / 1000
        return dt.datetime.fromtimestamp(value).strftime("%Y-%m-%d")
    text = str(value)
    try:
        if text.endswith("Z"):
            parsed = dt.datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            parsed = dt.datetime.fromisoformat(text)
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone()
        return parsed.strftime("%Y-%m-%d")
    except Exception:
        return dt.datetime.now().strftime("%Y-%m-%d")


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def add_usage(
    day: str,
    session_key: str,
    model: str,
    input_tokens: int,
    output_tokens: int,
    cache_read: int,
    cache_write: int,
    state: dict[str, Any],
) -> None:
    total = input_tokens + output_tokens + cache_read + cache_write
    state["total_prompts"] += 1
    state["total_sessions"].add(session_key)
    state["active_days"].add(day)

    bucket = state["model_usage"].setdefault(model, empty_bucket())
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write

    if day in state["recent"]:
        state["recent"][day]["messageCount"] += total

    if day == state["today"]:
        state["today_prompts"] += 1
        state["today_sessions"].add(session_key)
        state["today_total_tokens"] += total
        state["today_tokens_by_model"][model] = state["today_tokens_by_model"].get(model, 0) + total


def extract_usage(usage: dict[str, Any]) -> tuple[int, int, int, int]:
    total = number(usage.get("totalTokens"))
    input_tokens = number(usage.get("input"))
    output_tokens = number(usage.get("output"))
    cache_read = number(usage.get("cacheRead"))
    cache_write = number(usage.get("cacheWrite"))

    # Fallback: some providers only report total.
    if total and not (input_tokens or output_tokens or cache_read or cache_write):
        input_tokens = total

    return input_tokens, output_tokens, cache_read, cache_write


def model_name(raw: Any) -> str:
    value = str(raw or "pi")
    return value if value else "pi"


def scan_sessions() -> dict[str, Any]:
    now = dt.datetime.now()
    today = now.strftime("%Y-%m-%d")
    recent_dates = [(now - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]

    state: dict[str, Any] = {
        "today": today,
        "recent": {day: {"date": day, "messageCount": 0} for day in recent_dates},
        "today_prompts": 0,
        "today_sessions": set(),
        "today_total_tokens": 0,
        "today_tokens_by_model": {},
        "total_prompts": 0,
        "total_sessions": set(),
        "active_days": set(),
        "model_usage": {},
        "has_local_stats": False,
        "has_prompt_stats": True,
    }

    root = sessions_root()
    if not root.exists():
        return state

    seen_messages: set[str] = set()

    for path in root.rglob("*.jsonl"):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
        except Exception:
            continue

        session_key = str(path)
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except Exception:
                continue

            if entry.get("type") != "message":
                continue

            message_key = f"{session_key}:{entry.get('id')}"
            if message_key in seen_messages:
                continue
            seen_messages.add(message_key)

            message = entry.get("message") or {}
            role = message.get("role")
            timestamp = entry.get("timestamp") or message.get("timestamp")
            day = local_day(timestamp)

            usage = message.get("usage") or {}

            # Tool results can contain nested LLM usage from tool execution.
            if role == "toolResult" and not usage:
                details = message.get("details") or {}
                usage = details.get("usage") or {}

            if not usage:
                continue

            input_tokens, output_tokens, cache_read, cache_write = extract_usage(usage)
            if not (input_tokens or output_tokens or cache_read or cache_write):
                continue

            state["has_local_stats"] = True

            model = model_name(message.get("model"))
            add_usage(
                day,
                session_key,
                model,
                input_tokens,
                output_tokens,
                cache_read,
                cache_write,
                state,
            )

    return state


def build_record(args: argparse.Namespace) -> dict[str, Any]:
    state = scan_sessions()

    recent_days = [state["recent"][day] for day in sorted(state["recent"].keys())]

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "ready": state["has_local_stats"],
        "hasLocalStats": state["has_local_stats"],
        "hasPromptStats": state["has_prompt_stats"],
        "todayPrompts": state["today_prompts"],
        "todaySessions": len(state["today_sessions"]),
        "todayTotalTokens": state["today_total_tokens"],
        "todayTokensByModel": state["today_tokens_by_model"],
        "recentDays": recent_days,
        "totalPrompts": state["total_prompts"],
        "totalSessions": len(state["total_sessions"]),
        "activeDays": len(state["active_days"]),
        "activeDates": sorted(state["active_days"]),
        "modelUsage": state["model_usage"],
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": AUTH_HELP,
        "updatedAt": dt.datetime.now().astimezone().isoformat(),
    }
    return record


def main() -> int:
    parser = argparse.ArgumentParser(description="Collect Pi agent usage.")
    parser.add_argument("--force", action="store_true", help="Ignored; accepted for compatibility.")
    parser.add_argument("--limits-only", action="store_true", help="Ignored; Pi has no upstream limits endpoint.")
    args = parser.parse_args()

    record = build_record(args)
    json.dump(record, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
